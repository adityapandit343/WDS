@model WhatsAppBusinessInbox.Models.Campaign
@{
    ViewData["Title"] = "Campaign details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@Model.Name</h2>
    <div>
        @if (Model.Status != "running" && Model.Status != "completed")
        {
            <form asp-action="Start" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-success">Start sending</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Template</dt>
    <dd class="col-sm-9">@Model.TemplateName (@Model.TemplateLanguage)</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        <span class="badge @(Model.Status == "completed" ? "bg-success" : Model.Status == "running" ? "bg-warning text-dark" : "bg-secondary")">@Model.Status</span>
    </dd>

    <dt class="col-sm-3">Progress</dt>
    <dd class="col-sm-9">@Model.SentCount / @Model.TotalCount sent, @Model.FailedCount failed</dd>

    <dt class="col-sm-3">Variables</dt>
    <dd class="col-sm-9"><code>@Model.TemplateVariablesJson</code></dd>

    <dt class="col-sm-3">Started</dt>
    <dd class="col-sm-9">@(Model.StartedAt?.ToString("g") ?? "-")</dd>

    <dt class="col-sm-3">Completed</dt>
    <dd class="col-sm-9">@(Model.CompletedAt?.ToString("g") ?? "-")</dd>
</dl>

<h4>Recipients</h4>
<table class="table table-sm align-middle">
    <thead>
        <tr>
            <th>Contact</th>
            <th>Phone</th>
            <th>Status</th>
            <th>Error</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var recipient in Model.Recipients.OrderBy(r => r.Id))
        {
            <tr>
                <td>@recipient.Contact?.Name</td>
                <td>@recipient.Contact?.Phone</td>
                <td>
                    <span class="badge @(recipient.Status == "sent" ? "bg-success" : recipient.Status == "failed" ? "bg-danger" : "bg-secondary")">
                        @recipient.Status
                    </span>
                </td>
                <td class="text-danger small">@recipient.Error</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Status == "running")
{
    <p class="text-muted">Sending is in progress in the background. Refresh this page to see progress.</p>
}
