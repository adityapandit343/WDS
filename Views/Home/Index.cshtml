@{
    ViewData["Title"] = "Home";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="text-center mb-4">
        <h1 class="display-5">WhatsApp Business Inbox</h1>
        <p class="lead text-muted">Send and receive WhatsApp messages, run campaigns and collect feedback.</p>
    </div>

    <div class="row g-3">
        <div class="col-md-3"><a asp-controller="Chat" asp-action="Index" class="text-decoration-none"><div class="card h-100"><div class="card-body"><h5>Inbox</h5><p class="text-muted mb-0">Live conversations with customers.</p></div></div></a></div>
        <div class="col-md-3"><a asp-controller="Contacts" asp-action="Index" class="text-decoration-none"><div class="card h-100"><div class="card-body"><h5>Contacts</h5><p class="text-muted mb-0">Manage contacts and CSV import.</p></div></div></a></div>
        <div class="col-md-3"><a asp-controller="Templates" asp-action="Index" class="text-decoration-none"><div class="card h-100"><div class="card-body"><h5>Templates</h5><p class="text-muted mb-0">Sync and manage Meta templates.</p></div></div></a></div>
        <div class="col-md-3"><a asp-controller="Campaigns" asp-action="Index" class="text-decoration-none"><div class="card h-100"><div class="card-body"><h5>Campaigns</h5><p class="text-muted mb-0">Bulk messaging in the background.</p></div></div></a></div>
        <div class="col-md-3"><a asp-controller="Feedbacks" asp-action="Index" class="text-decoration-none"><div class="card h-100"><div class="card-body"><h5>Feedback</h5><p class="text-muted mb-0">Post-call satisfaction replies.</p></div></div></a></div>
        @if (User.IsInRole("Admin"))
        {
            <div class="col-md-3"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none"><div class="card h-100"><div class="card-body"><h5>Admin</h5><p class="text-muted mb-0">Tenants, credentials and stats.</p></div></div></a></div>
        }
    </div>
}
else
{
    <div class="text-center mt-5">
        <h1 class="display-4">WhatsApp Business Inbox</h1>
        <p class="lead">Please log in to continue.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg">Login</a>
    </div>
}
