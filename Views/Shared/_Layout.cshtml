<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WhatsAppBusinessInbox</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WhatsAppBusinessInbox.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">W</span>
                <span><strong>wa<span>ve</span></strong><small>business inbox</small></span>
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="workspace-label">WORKSPACE</div>
                <nav class="app-nav" aria-label="Main navigation">
                    <a asp-controller="Chat" asp-action="Index"><span class="nav-glyph">↗</span>Inbox<span class="nav-dot"></span></a>
                    <a asp-controller="Contacts" asp-action="Index"><span class="nav-glyph">○</span>Contacts</a>
                    <a asp-controller="Templates" asp-action="Index"><span class="nav-glyph">▤</span>Templates</a>
                    <a asp-controller="Campaigns" asp-action="Index"><span class="nav-glyph">◒</span>Campaigns</a>
                    <a asp-controller="Feedbacks" asp-action="Index"><span class="nav-glyph">♡</span>Feedback</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="workspace-label admin-label">ADMINISTRATION</div>
                        <a asp-controller="Admin" asp-action="Index"><span class="nav-glyph">⌘</span>Admin</a>
                        <a asp-controller="Admin" asp-action="Users"><span class="nav-glyph">◎</span>Users</a>
                    }
                </nav>
            }
            <div class="sidebar-footer"><span class="status-pulse"></span>All systems operational</div>
        </aside>
        <div class="app-main">
            <header class="topbar">
                <div class="mobile-brand"><span class="brand-mark">W</span><strong>wave</strong></div>
                <div class="topbar-spacer"></div>
                <partial name="_LoginPartial" />
            </header>
            <div class="page-container">
                <main role="main" class="pb-3">
            @if (TempData["AdminMessage"] != null)
            {
                <div class="alert alert-success">@TempData["AdminMessage"]</div>
            }
            @if (TempData["ImportSuccess"] != null)
            {
                <div class="alert alert-success">@TempData["ImportSuccess"]</div>
            }
            @if (TempData["ImportError"] != null)
            {
                <div class="alert alert-danger">@TempData["ImportError"]</div>
            }
            @if (TempData["SyncMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SyncMessage"]</div>
            }
            @if (TempData["SyncError"] != null)
            {
                <div class="alert alert-danger">@TempData["SyncError"]</div>
            }
            @if (TempData["CampaignError"] != null)
            {
                <div class="alert alert-danger">@TempData["CampaignError"]</div>
            }
            @if (TempData["FeedbackMessage"] != null)
            {
                <div class="alert alert-success">@TempData["FeedbackMessage"]</div>
            }
            @RenderBody()
                </main>
            </div>
            <footer class="app-footer">© 2026 Wave Business Inbox <span>•</span> Built for meaningful conversations</footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
