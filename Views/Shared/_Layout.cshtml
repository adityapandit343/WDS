<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WhatsAppBusinessInbox</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WhatsAppBusinessInbox.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">WhatsApp Inbox</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Chat" asp-action="Index">Inbox</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Contacts" asp-action="Index">Contacts</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Templates" asp-action="Index">Templates</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Campaigns" asp-action="Index">Campaigns</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Feedbacks" asp-action="Index">Feedback</a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Admin</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Admin" asp-action="Users">Users</a>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @if (TempData["AdminMessage"] != null)
            {
                <div class="alert alert-success">@TempData["AdminMessage"]</div>
            }
            @if (TempData["ImportSuccess"] != null)
            {
                <div class="alert alert-success">@TempData["ImportSuccess"]</div>
            }
            @if (TempData["ImportError"] != null)
            {
                <div class="alert alert-danger">@TempData["ImportError"]</div>
            }
            @if (TempData["SyncMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SyncMessage"]</div>
            }
            @if (TempData["SyncError"] != null)
            {
                <div class="alert alert-danger">@TempData["SyncError"]</div>
            }
            @if (TempData["CampaignError"] != null)
            {
                <div class="alert alert-danger">@TempData["CampaignError"]</div>
            }
            @if (TempData["FeedbackMessage"] != null)
            {
                <div class="alert alert-success">@TempData["FeedbackMessage"]</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - WhatsAppBusinessInbox
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
