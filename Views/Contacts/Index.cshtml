@model IEnumerable<WhatsAppBusinessInbox.Models.Contact>

@{
    ViewData["Title"] = "Contacts";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Contacts</h2>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary">Add Contact</a>
            <form asp-action="Import" method="post" enctype="multipart/form-data" class="d-flex gap-2">
                <input type="file" name="file" accept=".csv" class="form-control" style="width: 220px;">
                <button type="submit" class="btn btn-success">Import CSV</button>
            </form>
        </div>
    </div>

    <form asp-action="Index" method="get" class="row g-2 mb-3">
        <div class="col-auto">
            <input type="text" name="search" class="form-control" placeholder="Search name or phone..." value="@Context.Request.Query["search"]" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-secondary">Search</button>
        </div>
    </form>

    <table class="table align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Tags</th>
                <th>Opt In</th>
                <th>Last Message</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Phone</td>
                    <td>@item.Tags</td>
                    <td>@(item.OptIn ? "Yes" : "No")</td>
                    <td>@item.LastMessageAt?.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        <a asp-controller="Chat" asp-action="Chat" asp-route-id="@item.Id" class="btn btn-sm btn-success">Chat</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
