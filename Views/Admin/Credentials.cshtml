@model WhatsAppBusinessInbox.Models.TenantCredentialsViewModel
@{
    ViewData["Title"] = "Tenant credentials";
}

<h2>Credentials &mdash; @Model.TenantName</h2>
<p class="text-muted">Secrets are encrypted at rest with the Data Protection API. Leave a secret blank to keep the stored value.</p>

<div class="row">
    <div class="col-md-7">
        <form asp-action="Credentials" method="post">
            <input type="hidden" asp-for="TenantId" />
            <input type="hidden" asp-for="TenantName" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="PhoneNumberId" class="form-label"></label>
                <input asp-for="PhoneNumberId" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="BusinessAccountId" class="form-label"></label>
                <input asp-for="BusinessAccountId" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="ApiVersion" class="form-label"></label>
                <input asp-for="ApiVersion" class="form-control" placeholder="v21.0" />
            </div>
            <div class="mb-3">
                <label asp-for="VerifyToken" class="form-label"></label>
                <input asp-for="VerifyToken" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="AccessToken" class="form-label"></label>
                <input asp-for="AccessToken" class="form-control" placeholder="@(Model.HasAccessToken ? "(stored - leave blank to keep)" : "EAAG...")" />
            </div>
            <div class="mb-3">
                <label asp-for="AppSecret" class="form-label"></label>
                <input asp-for="AppSecret" class="form-control" placeholder="@(Model.HasAppSecret ? "(stored - leave blank to keep)" : "app secret")" />
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </form>
    </div>
</div>
