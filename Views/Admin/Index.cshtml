@model IEnumerable<WhatsAppBusinessInbox.Models.Tenant>
@{
    ViewData["Title"] = "Admin dashboard";
}

<h2 class="mb-4">Admin dashboard</h2>

<div class="row g-3 mb-4">
    <div class="col-md-2"><div class="card text-bg-primary"><div class="card-body"><h6>Tenants</h6><h3>@ViewBag.TenantCount</h3></div></div></div>
    <div class="col-md-2"><div class="card text-bg-secondary"><div class="card-body"><h6>Users</h6><h3>@ViewBag.UserCount</h3></div></div></div>
    <div class="col-md-2"><div class="card text-bg-info"><div class="card-body"><h6>Contacts</h6><h3>@ViewBag.ContactCount</h3></div></div></div>
    <div class="col-md-2"><div class="card text-bg-dark"><div class="card-body"><h6>Messages</h6><h3>@ViewBag.MessageCount</h3></div></div></div>
    <div class="col-md-2"><div class="card text-bg-warning"><div class="card-body"><h6>Campaigns</h6><h3>@ViewBag.CampaignCount</h3></div></div></div>
    <div class="col-md-2"><div class="card text-bg-success"><div class="card-body"><h6>Templates</h6><h3>@ViewBag.TemplateCount</h3></div></div></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card border-success"><div class="card-body"><h6>Satisfied</h6><h3>@ViewBag.SatisfiedCount</h3></div></div></div>
    <div class="col-md-3"><div class="card border-danger"><div class="card-body"><h6>Unsatisfied</h6><h3>@ViewBag.UnsatisfiedCount</h3></div></div></div>
    <div class="col-md-3"><div class="card border-secondary"><div class="card-body"><h6>Feedback total</h6><h3>@ViewBag.FeedbackCount</h3></div></div></div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Tenants</h4>
    <form asp-action="CreateTenant" method="post" class="d-flex gap-2">
        <input type="text" name="name" class="form-control" placeholder="New tenant name" required />
        <button type="submit" class="btn btn-primary">Add tenant</button>
    </form>
</div>

<table class="table aligns-middle">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Active</th>
            <th>Credentials</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tenant in Model)
        {
            <tr>
                <td>@tenant.Id</td>
                <td>@tenant.Name</td>
                <td>@(tenant.IsActive ? "Yes" : "No")</td>
                <td>
                    @if (tenant.Credentials.Any(c => !string.IsNullOrEmpty(c.EncryptedAccessToken)))
                    {
                        <span class="badge bg-success">Configured</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Not configured</span>
                    }
                </td>
                <td>@tenant.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-action="Credentials" asp-route-id="@tenant.Id" class="btn btn-sm btn-outline-primary">Credentials</a>
                </td>
            </tr>
        }
    </tbody>
</table>
